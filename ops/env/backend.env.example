VOICECHAT_BACKEND_HOST=127.0.0.1
VOICECHAT_BACKEND_PORT=4378
VOICECHAT_PUBLIC_ORIGIN=https://voicechat.sproce.com.br
VOICECHAT_ALLOWED_ORIGINS=https://voicechat.sproce.com.br
VOICECHAT_TRUST_PROXY=1
VOICECHAT_RATE_LIMIT_PER_MINUTE=120

# Server-only SHA-256 hex digest of the bearer token accepted from the desktop app.
# Never commit the token or its real hash.
VOICECHAT_AUTH_TOKEN_SHA256=replace_with_sha256_hex_digest
