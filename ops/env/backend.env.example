VOICECHAT_BACKEND_HOST=127.0.0.1
VOICECHAT_BACKEND_PORT=4378
VOICECHAT_PUBLIC_ORIGIN=https://voicechat.sproce.com.br
VOICECHAT_ALLOWED_ORIGINS=https://voicechat.sproce.com.br
VOICECHAT_TRUST_PROXY=1
VOICECHAT_RATE_LIMIT_PER_MINUTE=120

# Server-only SHA-256 hex digest of the bearer token accepted from the desktop app.
# Never commit the token or its real hash.
VOICECHAT_AUTH_TOKEN_SHA256=replace_with_sha256_hex_digest

# Optional comma-separated additional token hashes for user-scoped desktop tokens.
VOICECHAT_AUTH_TOKEN_SHA256_LIST=

# Server-only transcription provider. Keep mock for local/dev deployments.
VOICECHAT_TRANSCRIPTION_PROVIDER=mock
VOICECHAT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICECHAT_OPENAI_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
VOICECHAT_OPENAI_MODELS_ENDPOINT=https://api.openai.com/v1/models
VOICECHAT_OPENAI_TIMEOUT_MS=20000

# Production OpenAI key belongs only in the protected server environment.
# Do not place this value in the desktop client, repository, logs, or docs.
OPENAI_API_KEY=replace_only_on_server
